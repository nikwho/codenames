# Application locations under {{APP_BASE_PATH}} (default /codenames).
# Placeholders: {{APP_BASE_PATH}} {{APP_PORT}} {{FRONTEND_DIST_PATH}} {{APP_NAME}}
#
# Backend keeps /api and /socket.io at the Node process; nginx strips the prefix.

# /codenames → /codenames/
location = {{APP_BASE_PATH}} {
    return 301 {{APP_BASE_PATH}}/;
}

location {{APP_BASE_PATH}}/api/ {
    proxy_pass http://codenames_backend/api/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 10s;
    proxy_read_timeout 60s;
    proxy_send_timeout 60s;
}

location {{APP_BASE_PATH}}/socket.io/ {
    proxy_pass http://codenames_backend/socket.io/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 86400s;
    proxy_send_timeout 86400s;
    proxy_buffering off;
}

location = {{APP_BASE_PATH}}/health {
    proxy_pass http://codenames_backend/api/health;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
}

# SPA static files + client-side routes (/codenames/room/ABC → index.html)
location {{APP_BASE_PATH}}/ {
    alias {{FRONTEND_DIST_PATH}}/;
    try_files $uri $uri/ @{{APP_NAME}}_spa;
}

location @{{APP_NAME}}_spa {
    rewrite ^ {{APP_BASE_PATH}}/index.html last;
}

location = {{APP_BASE_PATH}}/index.html {
    alias {{FRONTEND_DIST_PATH}}/index.html;
}
