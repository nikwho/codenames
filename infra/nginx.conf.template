# Placeholders replaced by bootstrap-vps.sh / deploy tooling:
#   {{DOMAIN}}              public hostname
#   {{APP_DIR}}             e.g. /var/www/codenames
#   {{APP_PORT}}            Node listen port (default 3001)
#   {{FRONTEND_DIST_PATH}}  absolute path to Vite build output

upstream codenames_backend {
    server 127.0.0.1:{{APP_PORT}};
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name {{DOMAIN}};

    # After certbot, HTTPS server block will be added/managed automatically.
    # Keep HTTP for ACME + redirect once certificates exist.

    root {{FRONTEND_DIST_PATH}};
    index index.html;

    access_log /var/log/nginx/{{DOMAIN}}.access.log;
    error_log  /var/log/nginx/{{DOMAIN}}.error.log;

    client_max_body_size 8m;

    # React SPA (Vite build) — client-side routes
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Express API (and future REST routes)
    location /api/ {
        proxy_pass http://codenames_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # Socket.IO (Engine.IO) — WebSocket + long-polling
    location /socket.io/ {
        proxy_pass http://codenames_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_buffering off;
    }

    # Optional direct health (proxied) if someone hits /health without /api
    location = /health {
        proxy_pass http://codenames_backend/api/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }
}
