# Placeholders replaced by render-nginx.sh (SSL_MODE=http):
#   {{DOMAIN}} {{APP_DIR}} {{APP_PORT}} {{FRONTEND_DIST_PATH}} {{ACME_WEBROOT}} {{APP_NAME}}

upstream codenames_backend {
    server 127.0.0.1:{{APP_PORT}};
    keepalive 32;
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name {{DOMAIN}} _;

    access_log /var/log/nginx/{{DOMAIN}}.access.log;
    error_log  /var/log/nginx/{{DOMAIN}}.error.log;

    # Let's Encrypt http-01 (required for IP certificate issue + renewal)
    location ^~ /.well-known/acme-challenge/ {
        root {{ACME_WEBROOT}};
        default_type "text/plain";
    }

    include /etc/nginx/snippets/{{APP_NAME}}-app.conf;
}
